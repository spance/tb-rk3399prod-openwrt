diff --git a/target/linux/rockchip/patches-6.12/143-mmc-sdhci-of-arasan-disable-rk3399-cqe.patch b/target/linux/rockchip/patches-6.12/143-mmc-sdhci-of-arasan-disable-rk3399-cqe.patch
new file mode 100644
index 0000000..a1231ad
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/143-mmc-sdhci-of-arasan-disable-rk3399-cqe.patch
@@ -0,0 +1,30 @@
+From: OpenWrt TB-RK3399ProD port
+Subject: [PATCH] mmc: sdhci-of-arasan: disable CQE on RK3399
+
+Repeated command queue recovery was observed during otherwise successful
+eMMC writes on this RK3399 production platform.  Prefer storage reliability
+for the router workload while retaining HS400 Enhanced Strobe and ADMA.
+
+Use the existing SDHCI broken-CQE quirk with RK3399-specific platform data.
+
+---
+ drivers/mmc/host/sdhci-of-arasan.c | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+--- a/drivers/mmc/host/sdhci-of-arasan.c
++++ b/drivers/mmc/host/sdhci-of-arasan.c
+@@ -1433,5 +1433,13 @@
++static const struct sdhci_pltfm_data sdhci_arasan_rk3399_pdata = {
++	.ops = &sdhci_arasan_cqe_ops,
++	.quirks = SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN |
++		SDHCI_QUIRK_BROKEN_CQE,
++	.quirks2 = SDHCI_QUIRK2_PRESET_VALUE_BROKEN |
++		SDHCI_QUIRK2_CLOCK_DIV_ZERO_BROKEN,
++};
++
+ static struct sdhci_arasan_of_data sdhci_arasan_rk3399_data = {
+ 	.soc_ctl_map = &rk3399_soc_ctl_map,
+-	.pdata = &sdhci_arasan_cqe_pdata,
++	.pdata = &sdhci_arasan_rk3399_pdata,
+ 	.clk_ops = &arasan_clk_ops,
+ };
diff --git a/target/linux/rockchip/patches-6.12/144-phy-rockchip-typec-orientation-switch.patch b/target/linux/rockchip/patches-6.12/144-phy-rockchip-typec-orientation-switch.patch
new file mode 100644
index 0000000..6fe79f4
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/144-phy-rockchip-typec-orientation-switch.patch
@@ -0,0 +1,190 @@
+From ee5f73f20fb58416c06b576d6fa646fa3cab4c18 Mon Sep 17 00:00:00 2001
+From: TB-RK3399ProD OpenWrt project <noreply@example.invalid>
+Date: Sun, 26 Jul 2026 16:21:16 +0800
+Subject: [PATCH] phy: rockchip: support Type-C host orientation switching
+
+Backport the orientation-switch integration proposed by Rockchip for the
+RK3399 Type-C PHY, limited to the USB host path used by this board.
+
+The DWC3 core keeps its generic PHY powered while changing USB roles.  Mark
+the cached orientation invalid on detach, then reinitialize an active PHY for
+every new attachment before the role switch creates xHCI.  This also covers
+same-orientation reconnects, where the lane direction itself did not change.
+
+Link: https://lore.kernel.org/all/20260304094152.92-5-kernel@airkyi.com/
+---
+ drivers/phy/rockchip/Kconfig              |   1 +
+ drivers/phy/rockchip/phy-rockchip-typec.c | 118 ++++++++++++++++++++++
+ 2 files changed, 119 insertions(+)
+
+diff --git a/drivers/phy/rockchip/Kconfig b/drivers/phy/rockchip/Kconfig
+index dcb8e16..3677bfe 100644
+--- a/drivers/phy/rockchip/Kconfig
++++ b/drivers/phy/rockchip/Kconfig
+@@ -107,6 +107,7 @@ config PHY_ROCKCHIP_SNPS_PCIE3
+ config PHY_ROCKCHIP_TYPEC
+ 	tristate "Rockchip TYPEC PHY Driver"
+ 	depends on OF && (ARCH_ROCKCHIP || COMPILE_TEST)
++	depends on TYPEC || TYPEC=n
+ 	select EXTCON
+ 	select GENERIC_PHY
+ 	select RESET_CONTROLLER
+diff --git a/drivers/phy/rockchip/phy-rockchip-typec.c b/drivers/phy/rockchip/phy-rockchip-typec.c
+index 4efcb78..59538d7 100644
+--- a/drivers/phy/rockchip/phy-rockchip-typec.c
++++ b/drivers/phy/rockchip/phy-rockchip-typec.c
+@@ -54,6 +54,7 @@
+ 
+ #include <linux/mfd/syscon.h>
+ #include <linux/phy/phy.h>
++#include <linux/usb/typec_mux.h>
+ 
+ #define CMN_SSM_BANDGAP			(0x21 << 2)
+ #define CMN_SSM_BIAS			(0x22 << 2)
+@@ -372,6 +373,7 @@ struct rockchip_typec_phy {
+ 	struct device *dev;
+ 	void __iomem *base;
+ 	struct extcon_dev *extcon;
++	struct typec_switch_dev *sw;
+ 	struct regmap *grf_regs;
+ 	struct clk *clk_core;
+ 	struct clk *clk_ref;
+@@ -383,6 +385,7 @@ struct rockchip_typec_phy {
+ 	struct mutex lock;
+ 
+ 	bool flip;
++	bool orientation_valid;
+ 	u8 mode;
+ };
+ 
+@@ -935,6 +938,115 @@ unlock:
+ 	return 0;
+ }
+ 
++#if IS_ENABLED(CONFIG_TYPEC)
++/*
++ * The DWC3 core keeps the PHY powered across USB role changes.  The RK3399 PHY
++ * programs a different pair of physical lanes for each Type-C orientation, so
++ * updating tcphy->flip alone is too late.  Invalidate the cached orientation
++ * on detach, then reinitialize an active SuperSpeed PHY synchronously on every
++ * new attachment.  TCPM subsequently switches DWC3 to host and creates a fresh
++ * xHCI instance against the new lane mapping.
++ */
++static int tcphy_set_orientation(struct typec_switch_dev *sw,
++				 enum typec_orientation orientation)
++{
++	struct rockchip_typec_phy *tcphy = typec_switch_get_drvdata(sw);
++	const struct rockchip_usb3phy_port_cfg *cfg = tcphy->port_cfgs;
++	const struct usb3phy_reg *reg = &cfg->pipe_status;
++	bool flip;
++	int ret = 0;
++	int timeout;
++	u32 val;
++
++	mutex_lock(&tcphy->lock);
++	if (orientation == TYPEC_ORIENTATION_NONE) {
++		tcphy->orientation_valid = false;
++		goto out_unlock;
++	}
++
++	flip = orientation == TYPEC_ORIENTATION_REVERSE;
++	if (tcphy->orientation_valid && tcphy->flip == flip)
++		goto out_unlock;
++
++	tcphy->flip = flip;
++	tcphy->orientation_valid = true;
++	if (!(tcphy->mode & (MODE_DFP_USB | MODE_UFP_USB)))
++		goto out_unlock;
++
++	/* Stop advertising the SuperSpeed path while its lanes are reset. */
++	tcphy_cfg_usb3_to_usb2_only(tcphy, true);
++	tcphy_phy_deinit(tcphy);
++
++	ret = tcphy_phy_init(tcphy, tcphy->mode);
++	if (ret)
++		goto err_disconnected;
++
++	for (timeout = 0; timeout < 100; timeout++) {
++		regmap_read(tcphy->grf_regs, reg->offset, &val);
++		if (!(val & BIT(reg->enable_bit))) {
++			tcphy_cfg_usb3_to_usb2_only(tcphy, false);
++			goto out_unlock;
++		}
++		usleep_range(10, 20);
++	}
++
++	tcphy_phy_deinit(tcphy);
++	ret = -ETIMEDOUT;
++
++err_disconnected:
++	tcphy->orientation_valid = false;
++	tcphy->mode = MODE_DISCONNECT;
++out_unlock:
++	mutex_unlock(&tcphy->lock);
++	return ret;
++}
++
++static void tcphy_unregister_orientation_switch(void *data)
++{
++	struct rockchip_typec_phy *tcphy = data;
++
++	typec_switch_unregister(tcphy->sw);
++}
++
++static int tcphy_register_orientation_switch(struct rockchip_typec_phy *tcphy)
++{
++	struct typec_switch_desc desc = { };
++	struct device_node *np;
++	int ret = 0;
++
++	np = of_get_child_by_name(tcphy->dev->of_node, "usb3-port");
++	if (!np)
++		return 0;
++
++	if (!of_property_read_bool(np, "orientation-switch"))
++		goto out_put_node;
++
++	desc.drvdata = tcphy;
++	desc.fwnode = of_fwnode_handle(np);
++	desc.set = tcphy_set_orientation;
++
++	tcphy->sw = typec_switch_register(tcphy->dev, &desc);
++	if (IS_ERR(tcphy->sw)) {
++		ret = dev_err_probe(tcphy->dev, PTR_ERR(tcphy->sw),
++				    "failed to register Type-C orientation switch\n");
++		goto out_put_node;
++	}
++
++	ret = devm_add_action_or_reset(tcphy->dev,
++				       tcphy_unregister_orientation_switch,
++				       tcphy);
++
++out_put_node:
++	of_node_put(np);
++	return ret;
++}
++#else
++static int tcphy_register_orientation_switch(struct rockchip_typec_phy *tcphy)
++{
++	return 0;
++}
++#endif
++
+ static const struct phy_ops rockchip_usb3_phy_ops = {
+ 	.power_on	= rockchip_usb3_phy_power_on,
+ 	.power_off	= rockchip_usb3_phy_power_off,
+@@ -1183,6 +1295,12 @@ static int rockchip_typec_phy_probe(struct platform_device *pdev)
+ 		phy_set_drvdata(phy, tcphy);
+ 	}
+ 
++	ret = tcphy_register_orientation_switch(tcphy);
++	if (ret) {
++		pm_runtime_disable(dev);
++		return ret;
++	}
++
+ 	phy_provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+ 	if (IS_ERR(phy_provider)) {
+ 		dev_err(dev, "Failed to register phy provider\n");
+-- 
+2.54.0.windows.1
