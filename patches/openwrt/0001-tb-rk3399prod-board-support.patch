diff --git a/target/linux/rockchip/image/armv8.mk b/target/linux/rockchip/image/armv8.mk
--- a/target/linux/rockchip/image/armv8.mk
+++ b/target/linux/rockchip/image/armv8.mk
@@ -436,6 +436,23 @@ define Device/radxa_zero-3w
 endef
 TARGET_DEVICES += radxa_zero-3w
 
+define Device/toybrick_tb-rk3399prod
+  $(Device/rk3399)
+  DEVICE_VENDOR := Toybrick
+  DEVICE_MODEL := TB-RK3399ProD
+  DEVICE_DTS := rk3399pro-toybrick-prod
+  SUPPORTED_DEVICES := rockchip,rk3399pro-toybrick-prod
+  KERNEL := kernel-bin | fit none $$(KDIR)/image-rk3399pro-toybrick-prod.dtb
+  KERNEL_INSTALL := 1
+  IMAGES := rootfs.img
+  IMAGE_SIZE := 128m
+  IMAGE/rootfs.img := append-rootfs | check-size 120m | pad-to 128M
+  DEVICE_PACKAGES := block-mount e2fsprogs ethtool iperf3 kmod-fs-vfat \
+	kmod-rtw88-8822ce kmod-usb-storage kmod-usb-storage-uas mmc-utils pciutils \
+	usbutils
+endef
+TARGET_DEVICES += toybrick_tb-rk3399prod
+
 define Device/sinovoip_bpi-r2-pro
   $(Device/rk3568)
   DEVICE_VENDOR := Sinovoip
diff --git a/target/linux/rockchip/patches-6.12/140-arm64-dts-rockchip-build-toybrick-tb-rk3399prod.patch b/target/linux/rockchip/patches-6.12/140-arm64-dts-rockchip-build-toybrick-tb-rk3399prod.patch
