diff --git a/target/linux/rockchip/patches-6.12/141-dt-bindings-regulator-add-tcs4526.patch b/target/linux/rockchip/patches-6.12/141-dt-bindings-regulator-add-tcs4526.patch
new file mode 100644
index 0000000..c1c6d15
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/141-dt-bindings-regulator-add-tcs4526.patch
@@ -0,0 +1,21 @@
+From: OpenWrt TB-RK3399ProD port
+Subject: [PATCH] dt-bindings: regulator: fan53555: allow TCS4526
+
+The fan53555 regulator driver already has a tcs,tcs4526 match entry and
+handles its chip ID, but the binding only lists TCS4525.  Allow the compatible
+used by the TB-RK3399ProD GPU regulator.
+
+---
+ Documentation/devicetree/bindings/regulator/fcs,fan53555.yaml | 1 +
+ 1 file changed, 1 insertion(+)
+
+--- a/Documentation/devicetree/bindings/regulator/fcs,fan53555.yaml
++++ b/Documentation/devicetree/bindings/regulator/fcs,fan53555.yaml
+@@ -31,6 +31,7 @@ properties:
+           - silergy,syr827
+           - silergy,syr828
+           - tcs,tcs4525
++          - tcs,tcs4526
+       - items:
+           - const: rockchip,rk8601
+           - const: rockchip,rk8600
