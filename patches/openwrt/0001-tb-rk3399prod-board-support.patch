diff --git a/target/linux/rockchip/patches-6.12/143-mmc-sdhci-of-arasan-disable-rk3399-cqe.patch b/target/linux/rockchip/patches-6.12/143-mmc-sdhci-of-arasan-disable-rk3399-cqe.patch
new file mode 100644
index 0000000..a1231ad
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/143-mmc-sdhci-of-arasan-disable-rk3399-cqe.patch
@@ -0,0 +1,30 @@
+From: OpenWrt TB-RK3399ProD port
+Subject: [PATCH] mmc: sdhci-of-arasan: disable CQE on RK3399
+
+Repeated command queue recovery was observed during otherwise successful
+eMMC writes on this RK3399 production platform.  Prefer storage reliability
+for the router workload while retaining HS400 Enhanced Strobe and ADMA.
+
+Use the existing SDHCI broken-CQE quirk with RK3399-specific platform data.
+
+---
+ drivers/mmc/host/sdhci-of-arasan.c | 10 +++++++++-
+ 1 file changed, 9 insertions(+), 1 deletion(-)
+
+--- a/drivers/mmc/host/sdhci-of-arasan.c
++++ b/drivers/mmc/host/sdhci-of-arasan.c
+@@ -1433,5 +1433,13 @@
++static const struct sdhci_pltfm_data sdhci_arasan_rk3399_pdata = {
++	.ops = &sdhci_arasan_cqe_ops,
++	.quirks = SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN |
++		SDHCI_QUIRK_BROKEN_CQE,
++	.quirks2 = SDHCI_QUIRK2_PRESET_VALUE_BROKEN |
++		SDHCI_QUIRK2_CLOCK_DIV_ZERO_BROKEN,
++};
++
+ static struct sdhci_arasan_of_data sdhci_arasan_rk3399_data = {
+ 	.soc_ctl_map = &rk3399_soc_ctl_map,
+-	.pdata = &sdhci_arasan_cqe_pdata,
++	.pdata = &sdhci_arasan_rk3399_pdata,
+ 	.clk_ops = &arasan_clk_ops,
+ };
diff --git a/target/linux/rockchip/patches-6.12/144-phy-rockchip-typec-orientation-switch.patch b/target/linux/rockchip/patches-6.12/144-phy-rockchip-typec-orientation-switch.patch
new file mode 100644
index 0000000..1469dc5
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/144-phy-rockchip-typec-orientation-switch.patch
@@ -0,0 +1,201 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: TB-RK3399ProD OpenWrt project <noreply@example.invalid>
+Date: Mon, 27 Jul 2026 10:05:21 +0800
+Subject: [PATCH] phy: rockchip: add TCPM orientation for RK3399 Type-C
+
+Backport the USB orientation-switch path and power-on retry behavior from Rockchip develop-6.6. TCPM callbacks only record the connector state; hardware lane programming remains in the PHY power-on lifecycle.
+
+Link: https://github.com/rockchip-linux/kernel/tree/1ba51b059f25533c5529b7f68186190b47d6a7b3
+---
+ drivers/phy/rockchip/Kconfig              |   1 +
+ drivers/phy/rockchip/phy-rockchip-typec.c | 101 +++++++++++++++++++++-
+ 2 files changed, 99 insertions(+), 3 deletions(-)
+
+diff --git a/drivers/phy/rockchip/Kconfig b/drivers/phy/rockchip/Kconfig
+index dcb8e16..3677bfe 100644
+--- a/drivers/phy/rockchip/Kconfig
++++ b/drivers/phy/rockchip/Kconfig
+@@ -107,6 +107,7 @@ config PHY_ROCKCHIP_SNPS_PCIE3
+ config PHY_ROCKCHIP_TYPEC
+ 	tristate "Rockchip TYPEC PHY Driver"
+ 	depends on OF && (ARCH_ROCKCHIP || COMPILE_TEST)
++	depends on TYPEC || TYPEC=n
+ 	select EXTCON
+ 	select GENERIC_PHY
+ 	select RESET_CONTROLLER
+diff --git a/drivers/phy/rockchip/phy-rockchip-typec.c b/drivers/phy/rockchip/phy-rockchip-typec.c
+index 4efcb78..22a4fb4 100644
+--- a/drivers/phy/rockchip/phy-rockchip-typec.c
++++ b/drivers/phy/rockchip/phy-rockchip-typec.c
+@@ -54,6 +54,7 @@
+ 
+ #include <linux/mfd/syscon.h>
+ #include <linux/phy/phy.h>
++#include <linux/usb/typec_mux.h>
+ 
+ #define CMN_SSM_BANDGAP			(0x21 << 2)
+ #define CMN_SSM_BIAS			(0x22 << 2)
+@@ -331,6 +332,7 @@
+ #define DP_MODE_ENTER_A2		0xc104
+ 
+ #define PHY_MODE_SET_TIMEOUT		100000
++#define POWER_ON_TRIES			5
+ 
+ #define PIN_ASSIGN_C_E			0x51d9
+ #define PIN_ASSIGN_D_F			0x5100
+@@ -372,6 +374,7 @@ struct rockchip_typec_phy {
+ 	struct device *dev;
+ 	void __iomem *base;
+ 	struct extcon_dev *extcon;
++	struct typec_switch_dev *sw;
+ 	struct regmap *grf_regs;
+ 	struct clk *clk_core;
+ 	struct clk *clk_ref;
+@@ -384,6 +387,7 @@ struct rockchip_typec_phy {
+ 
+ 	bool flip;
+ 	u8 mode;
++	u8 new_mode;
+ };
+ 
+ struct phy_reg {
+@@ -812,7 +816,7 @@ static int tcphy_get_mode(struct rockchip_typec_phy *tcphy)
+ 	int ret, ufp, dp;
+ 
+ 	if (!edev)
+-		return MODE_DFP_USB;
++		return tcphy->new_mode;
+ 
+ 	ufp = extcon_get_state(edev, EXTCON_USB);
+ 	dp = extcon_get_state(edev, EXTCON_DISP_DP);
+@@ -862,9 +866,8 @@ static int tcphy_cfg_usb3_to_usb2_only(struct rockchip_typec_phy *tcphy,
+ 	return 0;
+ }
+ 
+-static int rockchip_usb3_phy_power_on(struct phy *phy)
++static int _rockchip_usb3_phy_power_on(struct rockchip_typec_phy *tcphy)
+ {
+-	struct rockchip_typec_phy *tcphy = phy_get_drvdata(phy);
+ 	const struct rockchip_usb3phy_port_cfg *cfg = tcphy->port_cfgs;
+ 	const struct usb3phy_reg *reg = &cfg->pipe_status;
+ 	int timeout, new_mode, ret = 0;
+@@ -916,6 +919,24 @@ unlock_ret:
+ 	return ret;
+ }
+ 
++static int rockchip_usb3_phy_power_on(struct phy *phy)
++{
++	struct rockchip_typec_phy *tcphy = phy_get_drvdata(phy);
++	int ret;
++	int tries;
++
++	for (tries = 0; tries < POWER_ON_TRIES; tries++) {
++		ret = _rockchip_usb3_phy_power_on(tcphy);
++		if (!ret)
++			break;
++	}
++
++	if (tries && !ret)
++		dev_info(tcphy->dev, "Needed %d loops to turn on\n", tries);
++
++	return ret;
++}
++
+ static int rockchip_usb3_phy_power_off(struct phy *phy)
+ {
+ 	struct rockchip_typec_phy *tcphy = phy_get_drvdata(phy);
+@@ -935,6 +956,73 @@ unlock:
+ 	return 0;
+ }
+ 
++#if IS_ENABLED(CONFIG_TYPEC)
++static int tcphy_set_orientation(struct typec_switch_dev *sw,
++				 enum typec_orientation orientation)
++{
++	struct rockchip_typec_phy *tcphy = typec_switch_get_drvdata(sw);
++
++	mutex_lock(&tcphy->lock);
++
++	if (orientation == TYPEC_ORIENTATION_NONE) {
++		tcphy->new_mode = MODE_DISCONNECT;
++		goto out_unlock;
++	}
++
++	tcphy->flip = orientation == TYPEC_ORIENTATION_REVERSE;
++	tcphy->new_mode = MODE_DFP_USB;
++
++out_unlock:
++	mutex_unlock(&tcphy->lock);
++	return 0;
++}
++
++static void tcphy_unregister_orientation_switch(void *data)
++{
++	struct rockchip_typec_phy *tcphy = data;
++
++	typec_switch_unregister(tcphy->sw);
++}
++
++static int tcphy_register_orientation_switch(struct rockchip_typec_phy *tcphy)
++{
++	struct typec_switch_desc desc = { };
++	struct device_node *np;
++	int ret = 0;
++
++	np = of_get_child_by_name(tcphy->dev->of_node, "usb3-port");
++	if (!np)
++		return 0;
++
++	if (!of_property_read_bool(np, "orientation-switch"))
++		goto out_put_node;
++
++	desc.drvdata = tcphy;
++	desc.fwnode = of_fwnode_handle(np);
++	desc.set = tcphy_set_orientation;
++
++	tcphy->sw = typec_switch_register(tcphy->dev, &desc);
++	if (IS_ERR(tcphy->sw)) {
++		ret = dev_err_probe(tcphy->dev, PTR_ERR(tcphy->sw),
++				    "failed to register Type-C orientation switch\n");
++		goto out_put_node;
++	}
++
++	ret = devm_add_action_or_reset(tcphy->dev,
++				       tcphy_unregister_orientation_switch,
++				       tcphy);
++
++out_put_node:
++	of_node_put(np);
++	return ret;
++}
++#else
++static int tcphy_register_orientation_switch(struct rockchip_typec_phy *tcphy)
++{
++	return 0;
++}
++#endif
++
+ static const struct phy_ops rockchip_usb3_phy_ops = {
+ 	.power_on	= rockchip_usb3_phy_power_on,
+ 	.power_off	= rockchip_usb3_phy_power_off,
+@@ -1142,6 +1230,7 @@ static int rockchip_typec_phy_probe(struct platform_device *pdev)
+ 		return ret;
+ 
+ 	tcphy->dev = dev;
++	tcphy->new_mode = MODE_DFP_USB;
+ 	platform_set_drvdata(pdev, tcphy);
+ 	mutex_init(&tcphy->lock);
+ 
+@@ -1183,6 +1272,12 @@ static int rockchip_typec_phy_probe(struct platform_device *pdev)
+ 		phy_set_drvdata(phy, tcphy);
+ 	}
+ 
++	ret = tcphy_register_orientation_switch(tcphy);
++	if (ret) {
++		pm_runtime_disable(dev);
++		return ret;
++	}
++
+ 	phy_provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+ 	if (IS_ERR(phy_provider)) {
+ 		dev_err(dev, "Failed to register phy provider\n");
diff --git a/target/linux/rockchip/patches-6.12/145-usb-dwc3-rk3399-typec-runtime-pm.patch b/target/linux/rockchip/patches-6.12/145-usb-dwc3-rk3399-typec-runtime-pm.patch
new file mode 100644
index 0000000..6087bc6
--- /dev/null
+++ b/target/linux/rockchip/patches-6.12/145-usb-dwc3-rk3399-typec-runtime-pm.patch
@@ -0,0 +1,63 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: TB-RK3399ProD OpenWrt project <noreply@example.invalid>
+Date: Mon, 27 Jul 2026 10:05:21 +0800
+Subject: [PATCH] usb: dwc3: runtime suspend unattached RK3399 OTG
+
+Backport the RK3399 runtime-PM lifecycle from Rockchip develop-6.6. Power the DWC3 core and generic PHY down while Type-C is unattached, then resume them after TCPM has selected the orientation and before the host role is created.
+
+Use a 100 ms autosuspend delay so a normal unplug/replug completes the PHY power cycle before the next Type-C attach debounce finishes.
+
+Link: https://github.com/rockchip-linux/kernel/tree/1ba51b059f25533c5529b7f68186190b47d6a7b3
+---
+ drivers/usb/dwc3/core.c | 24 ++++++++++++++++++++++--
+ 1 file changed, 22 insertions(+), 2 deletions(-)
+
+diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
+index 2cdb073..e6ac079 100644
+--- a/drivers/usb/dwc3/core.c
++++ b/drivers/usb/dwc3/core.c
+@@ -2291,6 +2291,23 @@ static int dwc3_probe(struct platform_device *pdev)
+ 	if (ret)
+ 		goto err_exit_debugfs;
+ 
++	/*
++	 * RK3399 Type-C orientation is known only after its external Type-C
++	 * controller reports an attachment.  Keep an unattached OTG controller
++	 * runtime suspended so its generic PHY is powered on only after TCPM has
++	 * selected the connector orientation.
++	 */
++	if (IS_REACHABLE(CONFIG_ARCH_ROCKCHIP) &&
++	    dwc->dr_mode == USB_DR_MODE_OTG &&
++	    of_device_is_compatible(dev->parent->of_node,
++				    "rockchip,rk3399-dwc3")) {
++		pm_runtime_set_autosuspend_delay(dev, 100);
++		pm_runtime_allow(dev);
++		pm_runtime_put_sync_suspend(dev);
++		dma_set_max_seg_size(dev, UINT_MAX);
++		return 0;
++	}
++
+ 	pm_runtime_put(dev);
+ 
+ 	dma_set_max_seg_size(dev, UINT_MAX);
+@@ -2450,7 +2467,8 @@ static int dwc3_suspend_common(struct dwc3 *dwc, pm_message_t msg)
+ 		dwc3_core_exit(dwc);
+ 		break;
+ 	default:
+-		/* do nothing */
++		if (!pm_runtime_suspended(dwc->dev))
++			dwc3_core_exit(dwc);
+ 		break;
+ 	}
+ 
+@@ -2517,7 +2535,9 @@ static int dwc3_resume_common(struct dwc3 *dwc, pm_message_t msg)
+ 
+ 		break;
+ 	default:
+-		/* do nothing */
++		ret = dwc3_core_init_for_resume(dwc);
++		if (ret)
++			return ret;
+ 		break;
+ 	}
+ 
