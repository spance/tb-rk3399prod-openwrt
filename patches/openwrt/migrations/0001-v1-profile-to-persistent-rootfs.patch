From: TB-RK3399ProD OpenWrt port
Subject: migrate an existing v1 worktree to the consolidated board profile

This patch is only used when .work/openwrt already contains the original
board patch but not the persistent-rootfs profile changes. Fresh checkouts
receive the final profile directly from 0001-tb-rk3399prod-board-support.patch.

diff --git a/target/linux/rockchip/image/armv8.mk b/target/linux/rockchip/image/armv8.mk
--- a/target/linux/rockchip/image/armv8.mk
+++ b/target/linux/rockchip/image/armv8.mk
@@ -443,8 +443,11 @@ define Device/toybrick_tb-rk3399prod
   DEVICE_DTS := rk3399pro-toybrick-prod
   SUPPORTED_DEVICES := rockchip,rk3399pro-toybrick-prod
   KERNEL := kernel-bin | fit none $$(KDIR)/image-rk3399pro-toybrick-prod.dtb
-  IMAGES :=
-  DEVICE_PACKAGES := ethtool iperf3 kmod-fs-vfat kmod-usb-storage \
-	mmc-utils pciutils usbutils kmod-usb-storage-uas
+  KERNEL_INSTALL := 1
+  IMAGES := rootfs.img
+  IMAGE_SIZE := 128m
+  IMAGE/rootfs.img := append-rootfs | check-size 120m | pad-to 128M
+  DEVICE_PACKAGES := block-mount e2fsprogs ethtool iperf3 kmod-fs-vfat kmod-usb-storage \
+	mmc-utils pciutils usbutils kmod-usb-storage-uas
 endef
 TARGET_DEVICES += toybrick_tb-rk3399prod
