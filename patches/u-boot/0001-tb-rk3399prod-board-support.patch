From: TB-RK3399ProD OpenWrt project
Subject: [PATCH] rk3399pro: add TB-RK3399ProD boot reliability settings

Keep the removable-card path conservative and deterministic on the
TB-RK3399ProD.  The current Rockchip DWMMC driver contains the later FIFO
transfer fixes, so preserve an explicit DT request for PIO instead of
carrying the older IDMAC workaround.

Select the RK3399Pro-specific loader and trust INIs explicitly.  The generic
chip-name parser otherwise reduces CONFIG_ROCKCHIP_RK3399PRO to RK3399 and
silently packages the wrong firmware pair.

Accept both the standard zero and Rockchip 0xffffffff legacy-script table
terminators.  This keeps distro boot compatible with OpenWrt's standard
mkimage output while retaining compatibility with Rockchip's mkimage variant.

Only divert FIT images into Rockchip's private boot_fit path when that path is
actually configured.  Otherwise the generic FIT support incorrectly tries to
extract /images/resource from a standard OpenWrt FIT and aborts before the
standard bootm implementation can select its kernel and FDT configuration.

Restore the standard FIT rule that a flat device tree does not need a load
property.  Also keep failed FDT loads from exporting uninitialized addresses
or temporary configuration-name pointers, and only enable Rockchip's
no-relocation policy when its environment switch is explicitly true.

The RK3399Pro build is an OpenWrt-only target, so enter standard distro boot
directly instead of first probing Android, Rockchip private FIT and RK image
paths.  Distro boot still scans removable SD before eMMC and retains its later
USB/network recovery targets.

---
 arch/arm/dts/rk3399-evb.dts      |  6 ++++++
 arch/arm/mach-rockchip/board.c   |  6 +++---
 cmd/source.c                     | 20 +++++++++++++++++++-
 common/image-fdt.c               |  5 +++++
 common/image-fit.c               | 33 ++++++++++++++++++++++-----------
 configs/rk3399pro_defconfig      |  3 +++
 drivers/mmc/dw_mmc.c             | 28 ++++++++++++++++++++--------
 include/configs/evb_rk3399.h     |  4 ++++
 include/configs/rk3399_common.h  |  1 +
 9 files changed, 83 insertions(+), 23 deletions(-)

diff --git a/arch/arm/dts/rk3399-evb.dts b/arch/arm/dts/rk3399-evb.dts
index 7bb06881e9..940db6e4e8 100644
--- a/arch/arm/dts/rk3399-evb.dts
+++ b/arch/arm/dts/rk3399-evb.dts
@@ -245,5 +245,11 @@
 
 &sdmmc {
 	bus-width = <4>;
+	/*
+	 * TB-RK3399ProD: use the fixed FIFO path for reliable large reads from
+	 * removable media. Linux configures its own transfer mode after boot.
+	 */
+	max-frequency = <25000000>;
+	fifo-mode;
 	status = "okay";
 };

diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
index cd0ec30bac..c0b999eabe 100644
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -986,7 +986,7 @@ static void bootm_no_reloc(void)
 	char *ramdisk_high;
 	char *fdt_high;
 
-	if (!env_get_yesno("bootm-no-reloc"))
+	if (env_get_yesno("bootm-no-reloc") != 1)
 		return;
 
 	ramdisk_high = env_get("initrd_high");
@@ -1109,8 +1109,8 @@ int board_do_bootm(int argc, char * const argv[])
 	}
 #endif
 
-	/* FIT */
-#if IMAGE_ENABLE_FIT
+	/* Rockchip FIT */
+#ifdef CONFIG_ROCKCHIP_FIT_IMAGE
 	if (format == IMAGE_FORMAT_FIT) {
 		char boot_cmd[64];
 		int ret;

diff --git a/cmd/source.c b/cmd/source.c
index 6b1c8b744b..d9abc382b4 100644
--- a/cmd/source.c
+++ b/cmd/source.c
@@ -29,6 +29,7 @@ source (ulong addr, const char *fit_uname)
 	ulong		len;
 #if defined(CONFIG_IMAGE_FORMAT_LEGACY)
 	const image_header_t *hdr;
+	u32		*data_end;
 #endif
 	u32		*data;
 
@@ -87,7 +88,24 @@ source (ulong addr, const char *fit_uname)
 		 * past the zero-terminated sequence of image lengths to get
 		 * to the actual image data
 		 */
-		while (*data++ != IMAGE_PARAM_INVAL);
+		/*
+		 * Standard mkimage uses zero as the terminating size entry,
+		 * while the Rockchip variant uses IMAGE_PARAM_INVAL. Accept
+		 * both formats without scanning beyond the verified payload.
+		 */
+		data_end = (u32 *)((char *)data + image_get_data_size(hdr));
+		while (data < data_end && *data != 0 &&
+		       *data != IMAGE_PARAM_INVAL)
+			data++;
+		if (data >= data_end) {
+			puts ("Malformed Script\n");
+			return 1;
+		}
+		data++;
+		if (len > (ulong)((char *)data_end - (char *)data)) {
+			puts ("Truncated Script\n");
+			return 1;
+		}
 		break;
 #endif
 #if defined(CONFIG_FIT)
diff --git a/common/image-fdt.c b/common/image-fdt.c
index 066968ee56..65626be094 100644
--- a/common/image-fdt.c
+++ b/common/image-fdt.c
@@ -512,6 +512,11 @@ int boot_get_fdt(int flag, int argc, char * const argv[], uint8_t arch,
 					fdt_addr, &fit_uname_fdt,
 					&fit_uname_config,
 					arch, &load, &len);
+				if (fdt_noffset < 0) {
+					printf("Failed to load FDT from FIT image (%d)\n",
+					       fdt_noffset);
+					goto error;
+				}
 
 				images->fit_hdr_fdt = map_sysmem(fdt_addr, 0);
 				images->fit_uname_fdt = fit_uname_fdt;
diff --git a/common/image-fit.c b/common/image-fit.c
index fb4a4bd31d..cfde9033cc 100644
--- a/common/image-fit.c
+++ b/common/image-fit.c
@@ -2357,9 +2357,11 @@ int fit_image_load_index(bootm_headers_t *images, ulong addr,
 	}
 
 #if !defined(USE_HOSTCC)
+#if defined(CONFIG_FIT_CIPHER) || defined(CONFIG_FIT_IMAGE_POST_PROCESS)
 	ret = fit_image_get_load(fit, noffset, &load);
 	if (ret < 0)
 		return ret;
+#endif
 
 #if defined(CONFIG_FIT_CIPHER)
 	int cipher_noffset =
@@ -2495,7 +2497,7 @@ int boot_get_fdt_fit(bootm_headers_t *images, ulong addr,
 	const char *fit_uname_config = NULL;
 	char *fit_uname_config_copy = NULL;
 	char *next_config = NULL;
-	ulong load, len;
+	ulong load = 0, len = 0;
 #ifdef CONFIG_OF_LIBFDT_OVERLAY
 	ulong image_start, image_end;
 	ulong ovload, ovlen;
@@ -2513,9 +2515,10 @@ int boot_get_fdt_fit(bootm_headers_t *images, ulong addr,
 			return -ENOMEM;
 
 		next_config = strchr(fit_uname_config_copy, '#');
-		if (next_config)
+		if (next_config) {
 			*next_config++ = '\0';
-		if (next_config - 1 > fit_uname_config_copy)
+		}
+		if (*fit_uname_config_copy)
 			fit_uname_config = fit_uname_config_copy;
 	}
 
@@ -2535,6 +2538,12 @@ int boot_get_fdt_fit(bootm_headers_t *images, ulong addr,
 	fit = map_sysmem(addr, 0);
 
 	cfg_noffset = fit_conf_get_node(fit, fit_uname_config);
+	if (cfg_noffset < 0) {
+		fdt_noffset = cfg_noffset;
+		goto out;
+	}
+	/* Keep the returned name inside the FIT, not in the temporary copy. */
+	fit_uname_config = fdt_get_name(fit, cfg_noffset, NULL);
 
 	/* single blob, or error just return as well */
 	count = fit_conf_get_prop_node_count(fit, cfg_noffset, FIT_FDT_PROP);
@@ -2610,14 +2618,16 @@ int boot_get_fdt_fit(bootm_headers_t *images, ulong addr,
 #endif
 
 out:
-	if (datap)
-		*datap = load;
-	if (lenp)
-		*lenp = len;
-	if (fit_unamep)
-		*fit_unamep = fit_uname;
-	if (fit_uname_configp)
-		*fit_uname_configp = fit_uname_config;
+	if (fdt_noffset >= 0) {
+		if (datap)
+			*datap = load;
+		if (lenp)
+			*lenp = len;
+		if (fit_unamep)
+			*fit_unamep = fit_uname;
+		if (fit_uname_configp)
+			*fit_uname_configp = fit_uname_config;
+	}
 
 	if (fit_uname_config_copy)
 		free(fit_uname_config_copy);
diff --git a/configs/rk3399pro_defconfig b/configs/rk3399pro_defconfig
index 5af187c333..9828ec9efc 100644
--- a/configs/rk3399pro_defconfig
+++ b/configs/rk3399pro_defconfig
@@ -1,4 +1,5 @@
 CONFIG_ARM=y
+CONFIG_LOCALVERSION="-tb-rk3399prod"
 CONFIG_ARCH_ROCKCHIP=y
 CONFIG_SPL_LIBCOMMON_SUPPORT=y
 CONFIG_SPL_LIBGENERIC_SUPPORT=y
@@ -6,6 +7,8 @@ CONFIG_SYS_MALLOC_F_LEN=0x4000
 CONFIG_SPL_FIT_GENERATOR="arch/arm/mach-rockchip/make_fit_atf.py"
 CONFIG_ROCKCHIP_RK3399=y
 CONFIG_ROCKCHIP_RK3399PRO=y
+CONFIG_LOADER_INI="RK3399PROMINIALL.ini"
+CONFIG_TRUST_INI="RK3399PROTRUST.ini"
 CONFIG_ROCKCHIP_VENDOR_PARTITION=y
 CONFIG_CHIP_NAME="RK3399PRO"
 CONFIG_UBOOT_SIZE_KB=2048
diff --git a/drivers/mmc/dw_mmc.c b/drivers/mmc/dw_mmc.c
index 1015066c2c..a0753d0bfe 100644
--- a/drivers/mmc/dw_mmc.c
+++ b/drivers/mmc/dw_mmc.c
@@ -227,7 +227,13 @@ static int dwmci_data_transfer(struct dwmci_host *host, struct mmc_data *data)
 		mask = dwmci_readl(host, DWMCI_RINTSTS);
 		/* Error during data transfer. */
 		if (mask & (DWMCI_DATA_ERR | DWMCI_DATA_TOUT)) {
-			debug("%s: DATA ERROR!\n", __func__);
+			printf("DWMMC %s data error: RINTSTS=%08x STATUS=%08x "
+			       "CTRL=%08x BMOD=%08x mode=%s\n",
+			       host->name, mask,
+			       dwmci_readl(host, DWMCI_STATUS),
+			       dwmci_readl(host, DWMCI_CTRL),
+			       dwmci_readl(host, DWMCI_BMOD),
+			       host->fifo_mode ? "PIO" : "IDMAC");
 			/*
 			 * It is necessary to wait for several cycles before
 			 * resetting the controller while data timeout or error.
@@ -326,8 +332,10 @@ write_again:
 
 		/* Check for timeout. */
 		if (get_timer(start) > timeout) {
-			debug("%s: Timeout waiting for data!\n",
-			      __func__);
+			printf("DWMMC %s data timeout: RINTSTS=%08x STATUS=%08x "
+			       "mode=%s\n", host->name, mask,
+			       dwmci_readl(host, DWMCI_STATUS),
+			       host->fifo_mode ? "PIO" : "IDMAC");
 			ret = -ETIMEDOUT;
 			break;
 		}
@@ -821,12 +829,16 @@ static int dwmci_init(struct mmc *mmc)
 		return -EIO;
 	}
 
-	use_dma = SDMMC_GET_TRANS_MODE(dwmci_readl(host, DWMCI_HCON));
-	if (use_dma == DMA_INTERFACE_IDMA) {
-		host->fifo_mode = 0;
-	} else {
-		host->fifo_mode = 1;
+	/* Preserve an explicit board-DT request for PIO. */
+	if (!host->fifo_mode) {
+		use_dma = SDMMC_GET_TRANS_MODE(dwmci_readl(host, DWMCI_HCON));
+		if (use_dma == DMA_INTERFACE_IDMA)
+			host->fifo_mode = 0;
+		else
+			host->fifo_mode = 1;
 	}
+	if (host->fifo_mode)
+		printf("DWMMC %s: using PIO data transfers\n", host->name);
 
 	/* Enumerate at 400KHz */
 	dwmci_setup_bus(host, mmc->cfg->f_min);
