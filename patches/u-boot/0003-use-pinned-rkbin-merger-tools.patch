From: TB-RK3399ProD OpenWrt project
Subject: [PATCH] make.sh: use the pinned sibling build inputs

The project checkout exposes the vendor cross compilers directly below
prebuilts/gcc/{arm,aarch64}, while the helper expects an extra linux-x86 path
component.  Point it at the actual pinned sibling toolchain layout.

The helper also copies its bundled, older boot_merger and trust_merger over
the tools in the sibling rkbin checkout.  That makes it impossible to upgrade
the RK3399Pro DDR/miniloader and trusted firmware as one audited rkbin
baseline.  It also passes the legacy --replace option, which current
boot_merger no longer accepts.

Use the merger binaries that belong to the pinned rkbin checkout and pass the
standard INI directly.  U-Boot's loaderimage remains unchanged for packing
uboot.img.

---
 make.sh | 18 +++++++-----------
 1 file changed, 7 insertions(+), 11 deletions(-)

diff --git a/make.sh b/make.sh
--- a/make.sh
+++ b/make.sh
@@ -37,11 +37,10 @@ OBJ_ARM32=arm-linux-gnueabihf-objdump
 OBJ_ARM64=aarch64-linux-gnu-objdump
 GCC_ARM32=arm-linux-gnueabihf-
 GCC_ARM64=aarch64-linux-gnu-
-TOOLCHAIN_ARM32=../prebuilts/gcc/linux-x86/arm/gcc-linaro-6.3.1-2017.05-x86_64_arm-linux-gnueabihf/bin
-TOOLCHAIN_ARM64=../prebuilts/gcc/linux-x86/aarch64/gcc-linaro-6.3.1-2017.05-x86_64_aarch64-linux-gnu/bin
+TOOLCHAIN_ARM32=../prebuilts/gcc/arm/gcc-linaro-6.3.1-2017.05-x86_64_arm-linux-gnueabihf/bin
+TOOLCHAIN_ARM64=../prebuilts/gcc/aarch64/gcc-linaro-6.3.1-2017.05-x86_64_aarch64-linux-gnu/bin
 
 ########################################### User not touch #############################################
-BIN_PATH_FIXUP="--replace tools/rk_tools/ ./"
 RKTOOLS=./tools
 
 # Declare global INI file searching index name for every chip, update in select_chip_info()
@@ -641,7 +640,6 @@ pack_spl_loader_image()
 	cp ${OUTDIR}/tpl/u-boot-tpl.bin ${RKBIN}/.temp/
 	cp ${ini} ${RKBIN}/.temp/${RKCHIP_LOADER}MINIALL.ini -f
 
-	cp ${RKTOOLS}/boot_merger ${RKBIN}/${RKTOOLS}/
 	cd ${RKBIN}
 	if [ "$mode" = 'spl' ]; then	# pack tpl+spl
 		# Update ini
@@ -654,7 +652,7 @@ pack_spl_loader_image()
 
 	sed -i "s/FlashBoot=.*$/FlashBoot=.\/.temp\/u-boot-spl.bin/"  ${temp_ini}
 
-	${RKTOOLS}/boot_merger ${BIN_PATH_FIXUP} ${temp_ini}
+	${RKTOOLS}/boot_merger ${temp_ini}
 	rm ${RKBIN}/.temp -rf
 	cd -
 	ls *_loader_*.bin >/dev/null 2>&1 && rm *_loader_*.bin
@@ -676,7 +674,6 @@ pack_loader_image()
 		return
 	fi
 
-	cp ${RKTOOLS}/boot_merger ${RKBIN}/${RKTOOLS}/
 	ls *_loader_*.bin >/dev/null 2>&1 && rm *_loader_*.bin
 	cd ${RKBIN}
 
@@ -685,11 +682,11 @@ pack_loader_image()
 		do
 			if [ -f "$ini" ]; then
-				${RKTOOLS}/boot_merger ${BIN_PATH_FIXUP} $ini
+				${RKTOOLS}/boot_merger $ini
 				echo "pack loader okay! Input: $ini"
 			fi
 		done
 	else
-		${RKTOOLS}/boot_merger ${BIN_PATH_FIXUP} $ini
+		${RKTOOLS}/boot_merger $ini
 		echo "pack loader okay! Input: $ini"
 	fi
 
@@ -736,10 +733,9 @@ __pack_64bit_trust_image()
 		return
 	fi
 
-	cp ${RKTOOLS}/trust_merger ${RKBIN}/${RKTOOLS}/
 	cd ${RKBIN}
-	${RKTOOLS}/trust_merger ${PLATFORM_SHA} ${PLATFORM_RSA} ${PLATFORM_TRUST_IMG_SIZE} ${BIN_PATH_FIXUP} \
-				${PACK_IGNORE_BL32} ${ini}
+	${RKTOOLS}/trust_merger ${PLATFORM_SHA} ${PLATFORM_RSA} ${PLATFORM_TRUST_IMG_SIZE} \
+				${PACK_IGNORE_BL32} ${ini}
 
 	cd - && mv ${RKBIN}/trust*.img ./
 	echo "pack trust okay! Input: ${ini}"
